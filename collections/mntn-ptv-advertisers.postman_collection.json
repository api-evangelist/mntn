          "name": "List/Search advertisers",
          "request": {
            "name": "List/Search advertisers",
            "description": {
              "content": "Returns advertisers the caller is authorized to see, sorted by company name. Optionally filter by company name, company URL, timezone, or a cross-field query. Omitting filters returns the full authorized list. Searchable fields depend on the caller's advertiser view tier.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "advertisers"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<number>",
                  "description": "1-based page number."
                },
                {
                  "disabled": false,
                  "key": "perPage",
                  "value": "<number>",
                  "description": "Results per page (maximum 100)."
                },
                {
                  "disabled": false,
                  "key": "query",
                  "value": "<string>",
                  "description": "Cross-field search across permitted advertiser fields (OR). Numeric values also match advertiser ID."
                },
                {
                  "disabled": false,
                  "key": "companyName",
                  "value": "<string>",
                  "description": "Case-insensitive substring match on company name."
                },
                {
                  "disabled": false,
                  "key": "companyUrl",
                  "value": "<string>",
                  "description": "Case-insensitive substring match on company URL."
                },
                {
                  "disabled": false,
                  "key": "timezone",

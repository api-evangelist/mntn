        {
          "id": "bf0a8eb9-bc28-4ce6-8f8f-a2393a857694",
          "name": "Delete a creative",
          "request": {
            "name": "Delete a creative",
            "description": {
              "content": "Deletes a creative from the advertiser's library. This is a soft delete: the creative is archived and no longer appears in library listings, but its stored assets are not immediately purged.\n\n**Notes:** A creative that is still `processing` can be deleted; its analysis result is discarded. Deleting a creative does not affect campaigns it was previously associated with.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "creatives",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "advertiserId",
                  "value": "<number>",
                  "description": "(Required) Advertiser that owns the creative. Required; the delete is authorized and scoped to this advertiser."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<number>",
                  "key": "id",
                  "description": "(Required) Creative identifier."
                }
              ]
            },

          "name": "List creatives",
          "request": {
            "name": "List creatives",
            "description": {
              "content": "Returns the advertiser's creative library, newest first, with each creative's normalized processing status.\n\n**Filters:** `advertiserId` (required), `status`.\n\n**Notes:** Freshly uploaded creatives appear with `status: processing` and are unusable until it becomes `ready`; poll `GET /v1/creatives/{id}` for a single creative's status. The stored `videoUrl` is returned only at the full field scope.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "v1",
                "creatives"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<number>",
                  "description": "1-based page number."
                },
                {
                  "disabled": false,
                  "key": "perPage",
                  "value": "<number>",
                  "description": "Results per page (maximum 100)."
                },
                {
                  "disabled": false,
                  "key": "advertiserId",
                  "value": "<number>",
                  "description": "(Required) Advertiser whose creative library to list. Required; the read is authorized and scoped to this advertiser."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter by normalized processing status: `processing`, `ready`, `rejected`, or `in_review`."
